{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "global",
    "registry",
    "postgres",
    "logtoPostgres",
    "redis",
    "nats",
    "emqx",
    "tdengine",
    "backend",
    "mcpServer",
    "dataEngine",
    "transportHttp",
    "transportMqtt",
    "aiCopilot",
    "frontend",
    "logto",
    "ingress"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": ["environment", "publicUrls"],
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["local", "test", "prod"]
        },
        "storageClass": {"type": "string"},
        "publicUrls": {
          "type": "object",
          "required": ["backend", "logto", "logtoAdmin"],
          "properties": {
            "backend": {"type": "string", "minLength": 1},
            "logto": {"type": "string", "minLength": 1},
            "logtoAdmin": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "registry": {
      "type": "object",
      "required": ["create", "existingSecret", "server", "username", "password"],
      "properties": {
        "create": {"type": "boolean"},
        "existingSecret": {"type": "string"},
        "server": {"type": "string"},
        "username": {"type": "string"},
        "password": {"type": "string"},
        "email": {"type": "string"}
      }
    },
    "postgres": {"$ref": "#/definitions/database"},
    "logtoPostgres": {"$ref": "#/definitions/database"},
    "redis": {"$ref": "#/definitions/statefulComponent"},
    "nats": {"$ref": "#/definitions/statefulComponent"},
    "emqx": {"$ref": "#/definitions/statefulComponent"},
    "tdengine": {"$ref": "#/definitions/statefulComponent"},
    "backend": {"$ref": "#/definitions/application"},
    "mcpServer": {"$ref": "#/definitions/application"},
    "dataEngine": {"$ref": "#/definitions/application"},
    "transportHttp": {"$ref": "#/definitions/application"},
    "transportMqtt": {"$ref": "#/definitions/application"},
    "aiCopilot": {"$ref": "#/definitions/application"},
    "frontend": {"$ref": "#/definitions/application"},
    "logto": {"$ref": "#/definitions/application"},
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "frontend", "logto", "logtoAdmin"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "frontend": {"$ref": "#/definitions/ingressRoute"},
        "logto": {"$ref": "#/definitions/ingressRoute"},
        "logtoAdmin": {"$ref": "#/definitions/ingressRoute"}
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": ["string", "number"]},
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "annotations": {"type": "object"}
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "accessModes"],
      "properties": {
        "enabled": {"type": "boolean"},
        "storageClass": {"type": "string"},
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "size": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
        "dataSize": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
        "logSize": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"}
      }
    },
    "database": {
      "type": "object",
      "required": ["enabled", "image", "auth", "service", "persistence"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "auth": {
          "type": "object",
          "required": ["create", "existingSecret", "username", "password", "database"],
          "properties": {
            "create": {"type": "boolean"},
            "existingSecret": {"type": "string"},
            "username": {"type": "string", "minLength": 1},
            "password": {"type": "string"},
            "database": {"type": "string", "minLength": 1}
          }
        },
        "service": {"type": "object"},
        "persistence": {"$ref": "#/definitions/persistence"}
      }
    },
    "statefulComponent": {
      "type": "object",
      "required": ["enabled", "image", "service", "persistence"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "service": {"type": "object"},
        "persistence": {"$ref": "#/definitions/persistence"}
      }
    },
    "application": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "image": {"$ref": "#/definitions/image"},
        "service": {"$ref": "#/definitions/service"},
        "existingConfigSecret": {"type": "string"},
        "existingSecret": {"type": "string"}
      }
    },
    "ingressRoute": {
      "type": "object",
      "required": ["host", "path", "pathType", "tlsSecret"],
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "path": {"type": "string", "pattern": "^/"},
        "pathType": {
          "type": "string",
          "enum": ["Exact", "Prefix", "ImplementationSpecific"]
        },
        "tlsSecret": {"type": "string"}
      }
    }
  }
}
