# Docker Compose deployment. Use hex secrets (openssl rand -hex 32).
POSTGRES_PASSWORD=change-me-db-password
JWT_SECRET=change-me-to-a-random-secret
DEVICE_CREDENTIALS_KEY=change-me-to-a-random-device-credentials-key
HTTP_INGEST_TOKEN=change-me-ingest-token

# Published ports are bound to localhost by default.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
BACKEND_PORT=8000
HTTP_INGEST_PORT=8081
MQTT_PORT=1883

# Logto and its dedicated PostgreSQL database.
LOGTO_TAG=latest
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002
LOGTO_POSTGRES_PASSWORD=change-me-logto-db-password
LOGTO_PRIVATE_KEY_ROTATION_GRACE_PERIOD=
LOGTO_SSRF_ALLOWED_ADDRESSES=
LOGTO_SSRF_PROTECTION_DISABLED=
LOGTO_OIDC_PROVIDER_SSRF_PROTECTION_DISABLED=

# Frontend Logto SPA settings. Fill VITE_LOGTO_APP_ID from Logto Admin.
VITE_LOGTO_ENDPOINT=http://localhost:3001
VITE_LOGTO_APP_ID=
VITE_LOGTO_RESOURCE=http://localhost:8000

# AI Copilot starts with this placeholder; chat requires a real provider key.
AI_MODEL_BASE_URL=https://api.openai.com/v1
AI_MODEL_API_KEY=not-configured
AI_MODEL_ID=gpt-4o-mini

# Optional R2 / S3-compatible OTA file storage.
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
