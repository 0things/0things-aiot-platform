mainmenu "IoT scaffold"
source "Kconfig.zephyr"
menu "IoT application"
config APP_LOG_LEVEL
 int "Application log level"
 range 0 4
 default 3
config APP_MAX_COLLECTORS
 int "Maximum registered collectors"
 range 3 16
 default 8
config APP_CACHE_SIZE
 int "Maximum records per collector"
 range 6 256
 default 64
config APP_BATCH_SIZE
 int "Records per MQTT batch"
 range 1 8
 default 4
config APP_PAYLOAD_SIZE
 int "Maximum JSON payload bytes"
 range 1024 8192
 default 2048
config APP_MOCK_SENSOR
 bool "Use deterministic mock sensors"
 default y
config APP_DEVICE_ID
 string "Fallback device identifier (letters, digits, underscore, hyphen)"
 default "device-001"
config APP_TEMPERATURE
 bool "Temperature collector"
 default y
config APP_IMU
 bool "IMU collector"
 default y
config APP_BATTERY
 bool "Battery collector"
 default y
